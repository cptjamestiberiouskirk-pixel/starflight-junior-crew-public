        "speaker": "Science Officer Finn",
        "type": "banter"
      },
      {
        "id": "msg-1792634570670-0.6416072230629225",
        "text": "Navigating through this asteroid belt requires an additional 250 M.U. per hour hazard surcharge.",
        "post": "Communications",
        "speaker": "Communications Cora",
        "type": "banter"
      },
      {
        "id": "msg-1792634548009-0.07306999302915795",
        "text": "I polished the dashboard dials. Try not to smudge the primary navigation chronometer!",
        "post": "Science Officer",
        "speaker": "Science Officer Finn",
        "type": "banter"
      },
      {
        "id": "msg-1792634478473-0.867541914232703",
        "text": "Post assignments finalized. Remember: charity is a misdemeanor under Interstel commercial code.",
